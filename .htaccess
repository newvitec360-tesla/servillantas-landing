# === Servillantas El Puente — Landing Only ===
# Domain: servillantaselpuente.com

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block access to sensitive files
<FilesMatch "^\.env$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|bak|old)$">
    Require all denied
</FilesMatch>

# Block storage directory
RewriteRule ^storage/ - [F,L]

# DirectoryIndex — serve index.php first
DirectoryIndex index.php index.html
